# --- Rust / Cargo ---
/target/
**/*.rs.bk
*.pdb
# Keep /Cargo.lock tracked for reproducible binary builds

# --- Packaged build outputs ---
/dist/
*.deb
*.rpm
*.AppImage

# --- Android / Gradle / Kotlin ---
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/captures/
/android/local.properties
/android/app/release/
*.apk
*.aab
*.ap_
*.dex
# Keep Gradle wrapper jar tracked
!android/gradle/wrapper/gradle-wrapper.jar

# --- Signing keystores, credentials & runtime TLS state ---
*.jks
*.keystore
keystore.properties
key.properties
*.pem
*.key
*.p12
*.pfx
*.der
trust_store*.json
identity*.json

# --- Editors, OS & logs ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.log
